                  "id": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer"
                  }
                },
                "required": [
                  "kind",
                  "id",
                  "quantity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "day",
            "rewards"
          ],
          "additionalProperties": false
        }
      }
